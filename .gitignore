# ── Secrets & environment (never commit) ──
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep
*service-account*.json
*.pem
*.key
infra/cloudflared/*.json

# ── Watchdog ──
logs/
# ntfy topic name. Public-but-unguessable, same stance as any other credential:
# anyone who knows it can read and post alerts. infra/watchdog.ps1 degrades
# quietly to "no notifications" when it is absent.
infra/.ntfy-topic

# ── Runtime data (quote-ref counter lives here in local dev) ──
data/

# ── Python (apps/api) ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Node / frontend (apps/web) ──
node_modules/
.next/
.nuxt/
.svelte-kit/
.turbo/
.vite/
dist/
build/
coverage/
playwright-report/
test-results/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
*.local

# ── Rust / compiled output (none today; here so a future crate cannot
#    push a build dir to the remote by accident) ──
target/

# ── OS / editors ──
.DS_Store
Thumbs.db
.idea/

# NOTE: packages/contracts/openapi.json and apps/web/src/lib/api/schema.d.ts are
# GENERATED but deliberately COMMITTED — a fresh clone must typecheck with no
# Python installed, and CI diffs them to catch contract drift. Do not ignore them.

# ── native (no-Docker) deployment ──
# Local virtualenv for the native Windows stack. Machine-specific, never committed.
.venv-native/

# staging worktree runtime data
data/staging/

# Database backups. These hold REAL customer names, phone numbers and payment
# records -- a `git add -A` that swept them in would publish customer data to
# the repo. Ignored so that cannot happen by accident.
backups/

# Incremental TypeScript build cache. Machine-local, changes on every build,
# and was showing up as a spurious diff on every promote.
apps/web/tsconfig.tsbuildinfo
