  "info": {
    "description": "Server-authoritative pricing for Myra Cleaning Services. Prices originate in PRICES.md and are mirrored in app/domain/pricing_data.py.",
    "title": "Myra Quote Calculator API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Service health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/pricing": {
      "get": {
        "operationId": "pricing_api_pricing_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingCatalogue"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Price catalogue",
        "tags": [
          "pricing"
        ]
      }
    },
    "/api/quote": {
      "post": {
        "operationId": "post_quote_api_quote_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Price a basket and build the WhatsApp handoff",
        "tags": [
          "quote"
        ]
      }
    },
    "/api/quote/{quote_ref}/sent": {
      "post": {
        "description": "Beacon from the Send button.\n\nWithout it every lead would sit at sent_to_wa=false and the drop-off metric\nSPEC §8 asks for would be meaningless. Idempotent — the button is guarded\nagainst double-taps, but a retried beacon must not be an error.",
        "operationId": "mark_sent_api_quote__quote_ref__sent_post",
        "parameters": [
          {
            "in": "path",
            "name": "quote_ref",
            "required": true,
            "schema": {
              "title": "Quote Ref",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mark a quote as handed off to WhatsApp",
        "tags": [
          "quote"
        ]
      }
    }
  }
}
