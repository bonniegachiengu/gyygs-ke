# Myra Quote Calculator — environment template.
# Copy to `.env` and fill in. NEVER commit the real .env or any secret files.

# ── App ─────────────────────────────
APP_VERSION=0.1.0
CORS_ORIGINS=https://myra.vyybandasky.online,http://localhost:5173
PUBLIC_SITE_HOST=myra.vyybandasky.online

# ── WhatsApp handoff ────────────────
WHATSAPP_NUMBER=254716869648

# ── Pricing rules (mirror of PRICES.md; see docs before changing) ──
# Minimum call-out floor. 0 = no floor, and 0 is the decision:
# Mercy, 16 Aug 2026 — "don't cap the price, no 1000 or 1500 or any other cap."
# The flyer's numbers are the numbers. ARCHITECTURE.md §5/§6 assumed 1500, but it
# was never in PRICES.md and it repriced real advertised jobs upward. The
# mechanism is kept so a floor is a config change if that ever changes.
MINIMUM_CALLOUT=0
# Pending Mercy's confirmation — FRIDAY_WITH_MERCY.md §3 ("you set the number").
RECURRING_DISCOUNT_PCT=10
# false = premises type decides the site-visit branch (office/commercial/BnB/
# post-construction), and a residential recurring basket still gets a real total.
RECURRING_REQUIRES_VISIT=false

# ── Lead store ──────────────────────
# memory | sheets  — explicit, never inferred from whether SHEET_ID is set.
LEAD_STORE=memory
SHEET_ID=
# Path to the service-account JSON key (the file itself is gitignored — never commit it):
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json

# ── Quote reference counter ─────────
QUOTE_SEQ_PATH=./data/quote_seq.json

# ── Rate limiting (POST /api/quote, per client IP) ──
RATE_LIMIT_QUOTE_PER_MIN=10
RATE_LIMIT_QUOTE_PER_HOUR=60

# ── Cloudflare Tunnel ───────────────
# Not needed for the named-tunnel (credentials-file) setup this repo uses —
# see infra/cloudflared/config.yml. Kept for the dashboard/token alternative.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Business identity (STUBS until Mercy registers) ──
BUSINESS_LEGAL_NAME=pending registration
BUSINESS_KRA_PIN=pending
BUSINESS_REG_NO=pending
VAT_REGISTERED=false
VAT_RATE=16

# ── eTIMS (off until onboarded; auto-issuance is a later stage) ──
ETIMS_ENABLED=false
ETIMS_MODE=manual
ETIMS_OSCU_URL=
ETIMS_OSCU_KEY=
ETIMS_OSCU_DEVICE_ID=

# ── Database (later; Sheets is the store for now) ──
# DATABASE_URL=
