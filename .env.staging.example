# Myrah STAGING environment.
#
# Every value here is deliberately different from production. The point of this
# file is that a mistake on staging cannot reach a real client or Mercy's money.
#
# * WHATSAPP_NUMBER IS THE TEST LINE (the 754 LaunchGear line). Mercy's real
#   business line -- which is ALSO the Pochi line real payments land on -- must
#   never appear in staging, in a test, or in CI. The number is deliberately NOT
#   written here, not even in a comment, so a grep for it stays a clean signal.
#   See PHASE_A_BUILD_BRIEF.md section 0.
WHATSAPP_NUMBER=254754413351   # the 754 test line. NEVER Mercy's real business line.

APP_VERSION=0.1.0-staging

# Separate database. NOT the production leads DB. Staging writes test rows and
# nobody should ever have to wonder whether a row on the board is real.
LEAD_STORE=sqlite
LEAD_DB_PATH=./data/staging/leads.db
QUOTE_SEQ_PATH=./data/staging/quote_seq.json

# Staging hostname. Note the HYPHEN, not a dot: Cloudflare Universal SSL covers
# *.vyybandasky.online but NOT *.myrah.vyybandasky.online, so a three-level
# name like staging.myrah.vyybandasky.online would fail TLS without paid
# Advanced Certificate Manager.
PUBLIC_SITE_HOST=staging-myrah.vyybandasky.online
CORS_ORIGINS=https://staging-myrah.vyybandasky.online,http://localhost:5173,http://127.0.0.1:3001

# Pricing rules mirror production so staging prices are trustworthy rehearsals.
MINIMUM_CALLOUT=0
RECURRING_DISCOUNT_PCT=10
RECURRING_REQUIRES_VISIT=false
RECURRING_DISCOUNT_FROM_JOB=2
RATE_LIMIT_QUOTE_PER_MIN=60
